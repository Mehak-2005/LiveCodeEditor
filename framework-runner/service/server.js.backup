import express from "express";
import path from "node:path";
import pty from "node-pty";
import { createServer } from "node:http";
import { WebSocketServer } from "ws";
import { randomUUID } from "node:crypto";
import {
  mkdir,
  writeFile,
  readdir,
  readFile,
  cp,
  rm,
  lstat,
  realpath
} from "node:fs/promises";
import { fileURLToPath } from "node:url";
import { execFile } from "node:child_process";
import { promisify } from "node:util";
import cors from "cors";
const app = express();
const PORT = Number(process.env.PORT) || 4000;
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const PROJECTS_DIR = path.resolve(__dirname, "../projects");
const TEMPLATES_DIR = path.resolve(__dirname, "../templates");
const ALLOWED_FRAMEWORKS = new Set(["django", "springboot"]);
const execFileAsync = promisify(execFile);
app.disable("x-powered-by");

app.use(express.json({ limit: "100kb" }));

app.use(
  cors({
    origin: "http://localhost:5173",
    methods: ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    allowedHeaders: ["Content-Type"],
  })
);

function getFrameworkConfig(framework) {

  if (framework === "django") {

    return { containerPort: 8000, imagePrefix: "livecode-project", displayName: "Django" };

  }

  if (framework === "springboot") {

    return { containerPort: 8080, imagePrefix: "livecode-project", displayName: "Spring Boot" };

  }

  return null;

}



function isValidProjectId(projectId) {

  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(projectId);

}



function getProjectPaths(projectId) {

  const projectPath = path.join(PROJECTS_DIR, projectId);

  return {

    projectPath,

    metadataPath: path.join(projectPath, "project.json"),

    appPath: path.join(projectPath, "app")

  };

}



async function readProjectMetadata(projectId) {

  const { metadataPath } = getProjectPaths(projectId);

  const metadata = JSON.parse(await readFile(metadataPath, "utf8"));

  if (metadata.projectId !== projectId || !ALLOWED_FRAMEWORKS.has(metadata.framework)) {

    throw new Error("Invalid project metadata.");

  }

  return metadata;

}



// Validate a relative project file path and reject traversal and symlinks.

function validateRelativeFilePath(requestedPath) {

  if (

    typeof requestedPath !== "string" ||

    requestedPath.length === 0 ||

    requestedPath.length > 500 ||

    requestedPath.includes("\\\\") ||

    requestedPath.startsWith("/") ||

    /^[a-zA-Z]:/.test(requestedPath) ||

    requestedPath.split("/").some((part) => !part || part === "." || part === "..")

  ) {

    return false;

  }

  return true;

}



async function resolveProjectFile(appPath, requestedPath) {

  if (!validateRelativeFilePath(requestedPath)) {

    const error = new Error("Provide a valid relative file path.");

    error.statusCode = 400;

    throw error;

  }



  const rootRealPath = await realpath(appPath);

  const candidatePath = path.resolve(rootRealPath, requestedPath);

  if (!candidatePath.startsWith(rootRealPath + path.sep)) {

    const error = new Error("File path is outside the project.");

    error.statusCode = 400;

    throw error;

  }



  // Reject symbolic links in every component, including the requested file.

  const parts = requestedPath.split("/");

  let currentPath = rootRealPath;

  for (const part of parts) {

    currentPath = path.join(currentPath, part);

    const info = await lstat(currentPath);

    if (info.isSymbolicLink()) {

      const error = new Error("Symbolic links are not allowed.");

      error.statusCode = 400;

      throw error;

    }

  }



  const info = await lstat(candidatePath);

  if (!info.isFile()) {

    const error = new Error("Requested path is not a file.");

    error.statusCode = 400;

    throw error;

  }

  return candidatePath;

}



app.get("/health", (_req, res) => {

  res.json({

    success: true,

    service: "Live Code Editor Framework Service",

    status: "running",

    frameworks: [...ALLOWED_FRAMEWORKS]

  });

});



// List projects.

app.get("/api/projects", async (_req, res) => {

  try {

    await mkdir(PROJECTS_DIR, { recursive: true });

    const entries = await readdir(PROJECTS_DIR, { withFileTypes: true });

    const projects = [];



    for (const entry of entries) {

      if (!entry.isDirectory()) continue;

      try {

        const metadata = JSON.parse(

          await readFile(path.join(PROJECTS_DIR, entry.name, "project.json"), "utf8")

        );

        if (metadata.projectId === entry.name && ALLOWED_FRAMEWORKS.has(metadata.framework)) {

          projects.push(metadata);

        }

      } catch {

        // Ignore directories that are not valid managed projects.

      }

    }

    projects.sort((a, b) => b.createdAt.localeCompare(a.createdAt));

    res.json({ success: true, projects });

  } catch (error) {

    console.error("Failed to list projects:", error);

    res.status(500).json({ success: false, error: "Unable to list projects." });

  }

});



// Create a project by copying the selected framework template.

app.post("/api/projects", async (req, res) => {

  let projectPath;

  try {

    const { name, framework } = req.body ?? {};

    if (typeof name !== "string" || !/^[a-zA-Z0-9_-]{1,40}$/.test(name)) {

      return res.status(400).json({

        success: false,

        error: "Project name must contain 1-40 letters, numbers, underscores, or hyphens."

      });

    }

    if (typeof framework !== "string" || !ALLOWED_FRAMEWORKS.has(framework.toLowerCase())) {

      return res.status(400).json({ success: false, error: "Framework must be django or springboot." });

    }



    const normalizedFramework = framework.toLowerCase();

    const templatePath = path.join(TEMPLATES_DIR, normalizedFramework);

    await readFile(path.join(templatePath, "Dockerfile"), "utf8");



    const projectId = randomUUID();

    projectPath = path.join(PROJECTS_DIR, projectId);

    await mkdir(PROJECTS_DIR, { recursive: true });

    await mkdir(projectPath);

    const appPath = path.join(projectPath, "app");

    await cp(templatePath, appPath, { recursive: true, errorOnExist: true, force: false });



    const metadata = {

      projectId,

      name,

      framework: normalizedFramework,

      createdAt: new Date().toISOString(),

      status: "created"

    };

    await writeFile(path.join(projectPath, "project.json"), JSON.stringify(metadata, null, 2), { flag: "wx" });

    res.status(201).json({ success: true, project: metadata, message: `${normalizedFramework} project created with template files.` });

  } catch (error) {

    console.error("Failed to create project:", error);

    if (projectPath) {

      try { await rm(projectPath, { recursive: true, force: true }); }

      catch (cleanupError) { console.error("Project cleanup failed:", cleanupError); }

    }

    res.status(500).json({ success: false, error: "Unable to create project. Check that its framework template exists." });

  }

});



// List files in a project's app directory, returning relative paths for a file explorer.

app.get("/api/projects/:projectId/files", async (req, res) => {

  const { projectId } = req.params;

  if (!isValidProjectId(projectId)) {

    return res.status(400).json({ success: false, error: "Invalid project ID." });

  }

  try {

    await readProjectMetadata(projectId);

    const { appPath } = getProjectPaths(projectId);

    const files = [];



    async function collectFiles(directory, relativeDirectory = "") {

      const entries = await readdir(directory, { withFileTypes: true });

      for (const entry of entries) {

        if (entry.isSymbolicLink()) continue;

        const relativePath = relativeDirectory ? `${relativeDirectory}/${entry.name}` : entry.name;

        const fullPath = path.join(directory, entry.name);

        if (entry.isDirectory()) await collectFiles(fullPath, relativePath);

        else if (entry.isFile()) files.push(relativePath);

      }

    }



    await collectFiles(appPath);

    files.sort();

    res.json({ success: true, projectId, files });

  } catch (error) {

    if (error.code === "ENOENT") {

      return res.status(404).json({ success: false, error: "Project or project files not found." });

    }

    console.error("Failed to list project files:", error);

    res.status(500).json({ success: false, error: "Unable to list project files." });

  }

});



// Read an individual source/configuration file from a project.

// Example: GET /api/projects/<uuid>/file?path=config/views.py



app.get("/api/projects/:projectId/file", async (req, res) => {

  const { projectId } = req.params;

  const requestedPath = req.query.path;



  if (!isValidProjectId(projectId)) {

    return res.status(400).json({

      success: false,

      error: "Invalid project ID."

    });

  }



  try {

    await readProjectMetadata(projectId);



    const { appPath } = getProjectPaths(projectId);

    const filePath = await resolveProjectFile(

      appPath,

      requestedPath

    );



    const content = await readFile(filePath, "utf8");



    return res.json({

      success: true,

      projectId,

      path: requestedPath,

      content

    });

  } catch (error) {

    if (error.statusCode) {

      return res.status(error.statusCode).json({

        success: false,

        error: error.message

      });

    }



    if (

      error.code === "ENOENT" ||

      error.code === "ENOTDIR"

    ) {

      return res.status(404).json({

        success: false,

        error: "Project or project file not found."

      });

    }



    console.error("Failed to read project file:", error);



    return res.status(500).json({

      success: false,

      error: "Unable to read project file."

    });

  }

});





app.put("/api/projects/:projectId/file", async (req, res) => {

  const { projectId } = req.params;

  const requestedPath = req.query.path ?? req.body?.path;

  const { content } = req.body ?? {};



  if (!isValidProjectId(projectId)) {

    return res.status(400).json({

      success: false,

      error: "Invalid project ID."

    });

  }



  if (typeof content !== "string") {

    return res.status(400).json({

      success: false,

      error: "File content must be a string."

    });

  }



  if (Buffer.byteLength(content, "utf8") > 100_000) {

    return res.status(413).json({

      success: false,

      error: "File content cannot exceed 100 KB."

    });

  }



  try {

    await readProjectMetadata(projectId);



    const { appPath } = getProjectPaths(projectId);

    const filePath = await resolveProjectFile(

      appPath,

      requestedPath

    );



    await writeFile(filePath, content, "utf8");



    return res.json({

      success: true,

      projectId,

      path: requestedPath,

      message: "Project file saved successfully."

    });

  } catch (error) {

    if (error.statusCode) {

      return res.status(error.statusCode).json({

        success: false,

        error: error.message

      });

    }



    if (

      error.code === "ENOENT" ||

      error.code === "ENOTDIR"

    ) {

      return res.status(404).json({

        success: false,

        error: "Project or project file not found."

      });

    }



    console.error("Failed to save project file:", error);



    return res.status(500).json({

      success: false,

      error: "Unable to save project file."

    });

  }

});
// Build and start a Django or Spring Boot project in a local Docker container.

app.post("/api/projects/:projectId/run", async (req, res) => {
  const { projectId } = req.params;
  if (!isValidProjectId(projectId)) {
    return res.status(400).json({ success: false, error: "Invalid project ID." });
  }

  let containerStarted = false;
  let containerName;

  try {
    const metadata = await readProjectMetadata(projectId);
    const config = getFrameworkConfig(metadata.framework);
    if (!config) {
      return res.status(400).json({ success: false, error: "Unsupported framework." });
    }

    const { appPath } = getProjectPaths(projectId);
    containerName = `lce-${projectId}`;

    // Reuse a running container for this project, and remove an old stopped one.
    try {
      const { stdout } = await execFileAsync("docker", [
        "inspect", "--format", "{{.State.Running}}", containerName,
      ], { timeout: 10000, maxBuffer: 1024 * 1024 });

      if (stdout.trim() === "true") {
        const appUrl = await getContainerUrl(containerName, config.containerPort);
        const { stdout: existingId } = await execFileAsync("docker", [
          "inspect", "--format", "{{.Id}}", containerName,
        ], { timeout: 10000, maxBuffer: 1024 * 1024 });

        return res.json({
          success: true,
          projectId,
          framework: metadata.framework,
          status: "running",
          containerId: existingId.trim(),
          url: appUrl,
          message: "Project is already running.",
        });
      }

      await execFileAsync("docker", ["rm", "-f", containerName], {
        timeout: 15000,
        maxBuffer: 1024 * 1024,
      });
    } catch (error) {
      const message = `${error.stderr || ""} ${error.message || ""}`;
      const containerMissing = /no such object|no such container|not found/i.test(message);
      if (!containerMissing && error.code !== 1) throw error;
    }

    const imageName = `${config.imagePrefix}-${projectId}:local`;
    await readFile(path.join(appPath, "Dockerfile"), "utf8");

    // Build the current saved files into this project's image.
    await execFileAsync("docker", ["build", "-t", imageName, appPath], {
      timeout: 300000,
      maxBuffer: 2 * 1024 * 1024,
    });

    // Docker allocates a free host port while keeping the container port fixed.
    const { stdout } = await execFileAsync("docker", [
      "run", "-d", "--rm", "--name", containerName,
      "--memory=512m", "--cpus=1", "--pids-limit=128",
      "--security-opt=no-new-privileges:true", "--cap-drop=ALL",
      "--read-only", "--tmpfs", "/tmp:rw,noexec,nosuid,size=64m",
      "-p", `127.0.0.1::${config.containerPort}`,
      imageName,
    ], { timeout: 30000, maxBuffer: 1024 * 1024 });

    containerStarted = true;
    const containerId = stdout.trim();
    const appUrl = await getContainerUrl(containerName, config.containerPort);

    return res.json({
      success: true,
      projectId,
      framework: metadata.framework,
      status: "starting",
      containerId,
      url: appUrl,
      message: `${config.displayName} container started. Wait a few seconds for the application to become ready.`,
    });
  } catch (error) {
    console.error("Failed to run framework project:", error);
    if (containerStarted && containerName) {
      try {
        await execFileAsync("docker", ["stop", "--time", "5", containerName], { timeout: 15000 });
      } catch (cleanupError) {
        console.error("Container cleanup failed:", cleanupError);
      }
    }

    return res.status(500).json({
      success: false,
      error: "Unable to start the project. Check Docker, project files, build output, and container logs.",
      details: error.message,
    });
  }
});


app.post("/api/projects/:projectId/terminal", async (req, res) => {
  const { projectId } = req.params;
  const command = req.body?.command;

  if (!isValidProjectId(projectId)) {
    return res.status(400).json({
      success: false,
      error: "Invalid project ID.",
    });
  }

  if (
    typeof command !== "string" ||
    !command.trim() ||
    command.length > 1000
  ) {
    return res.status(400).json({
      success: false,
      error: "Enter a command of up to 1000 characters.",
    });
  }

  const containerName = `lce-${projectId}`;

  try {
    // Confirm this project exists before accessing its container.
    await readProjectMetadata(projectId);

    // Check that the project's container is running.
    const { stdout: runningState } = await execFileAsync(
      "docker",
      ["inspect", "--format", "{{.State.Running}}", containerName],
      { timeout: 10000, maxBuffer: 256 * 1024 }
    );

    if (runningState.trim() !== "true") {
      return res.status(409).json({
        success: false,
        error: "Start the project before using its terminal.",
      });
    }

    // Execute the command inside this project's container,
    // never directly in the Windows host environment.
    const { stdout, stderr } = await execFileAsync(
      "docker",
      ["exec", containerName, "/bin/sh", "-lc", command],
      {
        timeout: 15000,
        maxBuffer: 256 * 1024,
        windowsHide: true,
      }
    );

    return res.json({
      success: true,
      projectId,
      output: [stdout, stderr].filter(Boolean).join("\n"),
      exitCode: 0,
    });
  } catch (error) {
    const output = [
      error.stdout,
      error.stderr,
    ].filter(Boolean).join("\n");

    if (error.code === "ENOENT") {
      return res.status(500).json({
        success: false,
        error: "Docker could not be found by the framework service.",
      });
    }

    if (error.killed || error.signal === "SIGTERM") {
      return res.status(408).json({
        success: false,
        error: "Command timed out after 15 seconds.",
        output: output.slice(0, 20000),
      });
    }

    // A command can fail even when Docker itself is working.
    if (typeof error.code === "number") {
      return res.json({
        success: true,
        projectId,
        output:
          output ||
          error.message ||
          "Command failed without output.",
        exitCode: error.code,
      });
    }

    console.error("Terminal command failed:", error);

    return res.status(500).json({
      success: false,
      error: "Could not execute the command in the project container.",
      details: output.slice(0, 20000),
    });
  }
});

async function getContainerUrl(containerName, containerPort) {
  const { stdout } = await execFileAsync("docker", [
    "port", containerName, `${containerPort}/tcp`,
  ], { timeout: 10000, maxBuffer: 1024 * 1024 });

  // Expected output: 127.0.0.1:49153
  const match = stdout.trim().match(/127\.0\.0\.1:(\d+)/);
  if (!match) {
    throw new Error(`Unable to determine the host port for ${containerName}. Docker returned: ${stdout.trim()}`);
  }
  return `http://127.0.0.1:${Number(match[1])}`;
};

// Check a project's Docker container status.

app.get("/api/projects/:projectId/status", async (req, res) => {
  const { projectId } = req.params;
  if (!isValidProjectId(projectId)) {
    return res.status(400).json({ success: false, error: "Invalid project ID." });
  }

  try {
    const metadata = await readProjectMetadata(projectId);
    const config = getFrameworkConfig(metadata.framework);
    const containerName = `lce-${projectId}`;

    try {
      const { stdout } = await execFileAsync("docker", [
        "inspect", "--format", "{{.State.Status}}", containerName,
      ], { timeout: 10000, maxBuffer: 1024 * 1024 });
      const dockerStatus = stdout.trim();
      const url = dockerStatus === "running"
        ? await getContainerUrl(containerName, config.containerPort)
        : null;

      return res.json({
        success: true,
        projectId,
        framework: metadata.framework,
        status: dockerStatus,
        url,
      });
    } catch (dockerError) {
      const message = `${dockerError.stderr || ""} ${dockerError.message || ""}`;
      if (dockerError.code === "ENOENT") throw dockerError;
      if (!/no such object|no such container|not found/i.test(message) && dockerError.code !== 1) {
        throw dockerError;
      }
      return res.json({
        success: true,
        projectId,
        framework: metadata.framework,
        status: "stopped",
        url: null,
        message: "The project exists, but its container is not running.",
      });
    }
  } catch (error) {
    if (error.code === "ENOENT") {
      return res.status(404).json({
        success: false,
        projectId,
        status: "not_found",
        error: "Project metadata was not found.",
      });
    }
    console.error("Failed to check project status:", error);
    return res.status(500).json({ success: false, projectId, error: "Unable to check project status." });
  }
});

// Retrieve recent container logs.

app.get("/api/projects/:projectId/logs", async (req, res) => {

  const { projectId } = req.params;

  if (!isValidProjectId(projectId)) {

    return res.status(400).json({ success: false, error: "Invalid project ID." });

  }

  try {

    const metadata = await readProjectMetadata(projectId);

    const { stdout, stderr } = await execFileAsync("docker", ["logs", "--tail", "100", `lce-${projectId}`], {

      timeout: 10000,

      maxBuffer: 1024 * 1024

    });

    res.json({ success: true, projectId, framework: metadata.framework, logs: `${stdout || ""}${stderr || ""}` });

  } catch (error) {

    console.error("Failed to retrieve project logs:", error);

    res.status(404).json({ success: false, projectId, error: "Unable to retrieve logs. Check whether the container is running." });

  }

});



// Stop a running project container.

app.post("/api/projects/:projectId/stop", async (req, res) => {

  const { projectId } = req.params;

  if (!isValidProjectId(projectId)) {

    return res.status(400).json({ success: false, error: "Invalid project ID." });

  }

  try {

    const metadata = await readProjectMetadata(projectId);

    await execFileAsync("docker", ["stop", "--time", "5", `lce-${projectId}`], { timeout: 15000 });

    res.json({ success: true, projectId, framework: metadata.framework, status: "stopped", message: `${metadata.framework} project container stopped successfully.` });

  } catch (error) {

    console.error("Failed to stop project:", error);

    res.status(404).json({ success: false, projectId, error: "Unable to stop the project. Check whether its container is running." });

  }

});


app.delete("/api/projects/:projectId", async (req, res) => {
  const { projectId } = req.params;

  if (!isValidProjectId(projectId)) {
    return res.status(400).json({
      success: false,
      error: "Invalid project ID.",
    });
  }

  try {
    // Confirm this is an existing, valid project.
    await readProjectMetadata(projectId);

    const { projectPath } = getProjectPaths(projectId);
    const containerName = `lce-${projectId}`;

    // Stop the project's container if it is running.
    try {
      await execFileAsync(
        "docker",
        ["stop", "--time", "5", containerName],
        { timeout: 15000, maxBuffer: 1024 * 1024 }
      );
    } catch (error) {
      // A missing container is fine; other Docker errors must be reported.
      const output = `${error.message || ""} ${error.stderr || ""}`;

      if (
        !output.includes("No such container") &&
        !output.includes("No such object")
      ) {
        throw error;
      }
    }

    // Delete only this project's directory and its files.
    await rm(projectPath, { recursive: true, force: false });

    return res.json({
      success: true,
      projectId,
      message: "Project deleted successfully.",
    });
  } catch (error) {
    console.error("Failed to delete project:", error);

    if (error.code === "ENOENT") {
      return res.status(404).json({
        success: false,
        error: "Project not found.",
      });
    }

    return res.status(500).json({
      success: false,
      error: "Unable to delete the project.",
    });
  }
});


const server = createServer(app);

const wss = new WebSocketServer({ server });

wss.on("connection", async (ws, req) => {
  let terminal;

  try {
    // Allow connections only from the local development frontend.
    const origin = req.headers.origin;

    if (
      origin !== "http://localhost:5173" &&
      origin !== "http://127.0.0.1:5173"
    ) {
      ws.close(1008, "Origin not allowed");
      return;
    }

    const requestUrl = new URL(
      req.url,
      `http://${req.headers.host || "127.0.0.1"}`
    );

    const projectId = requestUrl.searchParams.get("projectId");

    if (!projectId || !isValidProjectId(projectId)) {
      ws.close(1008, "Invalid project ID");
      return;
    }

    // Confirm that this project exists and has valid metadata.
    await readProjectMetadata(projectId);

    if (ws.readyState !== 1) return;

    const containerName = `lce-${projectId}`;

    // A terminal can only attach to an already-running project.
    const { stdout: runningState } = await execFileAsync(
      "docker",
      ["inspect", "--format", "{{.State.Running}}", containerName],
      { timeout: 10000, maxBuffer: 256 * 1024 }
    );

    if (runningState.trim() !== "true") {
      ws.send(JSON.stringify({
        type: "error",
        message: "Start the project before opening its terminal."
      }));
      ws.close(1000, "Project is not running");
      return;
    }

    if (ws.readyState !== 1) return;

    // Attach an interactive shell inside the project's Docker container.
    terminal = pty.spawn(
      "docker",
      ["exec", "-it", containerName, "/bin/sh"],
      {
        name: "xterm-color",
        cols: 80,
        rows: 24,
        cwd: process.cwd(),
        env: process.env
      }
    );

    terminal.onData((data) => {
      if (ws.readyState === 1) {
        ws.send(JSON.stringify({
          type: "output",
          data
        }));
      }
    });

    terminal.onExit(({ exitCode }) => {
      if (ws.readyState === 1) {
        ws.send(JSON.stringify({
          type: "exit",
          exitCode
        }));
        ws.close();
      }
    });

    ws.on("message", (rawMessage) => {
      try {
        const message = JSON.parse(rawMessage.toString());

        if (
          message.type === "input" &&
          typeof message.data === "string" &&
          message.data.length <= 4096
        ) {
          terminal.write(message.data);
        } else if (message.type === "resize") {
          const cols = Number(message.cols);
          const rows = Number(message.rows);

          if (
            Number.isInteger(cols) &&
            Number.isInteger(rows) &&
            cols >= 20 && cols <= 240 &&
            rows >= 5 && rows <= 100
          ) {
            terminal.resize(cols, rows);
          }
        }
      } catch {
        // Ignore malformed terminal messages.
      }
    });

    ws.on("close", () => {
      if (terminal) terminal.kill();
    });

    ws.on("error", () => {
      if (terminal) terminal.kill();
    });
  } catch (error) {
    console.error("Persistent terminal connection failed:", error);

    if (ws.readyState === 1) {
      ws.send(JSON.stringify({
        type: "error",
        message: "Could not open the project terminal. Make sure the project is running."
      }));
      ws.close(1011, "Terminal connection failed");
    }

    if (terminal) terminal.kill();
  }
});


server.listen(PORT, "127.0.0.1", () => {
  console.log(`Framework service running at http://127.0.0.1:${PORT}`);
  console.log(`Health endpoint: http://127.0.0.1:${PORT}/health`);
  console.log(`Project API: http://127.0.0.1:${PORT}/api/projects`);
  console.log("WebSocket server is ready for terminal connections.");
});
